#!/usr/bin/env bash
set -Eeuo pipefail

[[ $# -eq 0 ]] || {
  echo 'deploy-nathanlab accepts no arguments' >&2
  exit 64
}

readonly deploy_root='/mnt/Storage2_New/website-hosting/portfolio-v2'
readonly source_root="${GITHUB_WORKSPACE:-}"
readonly version="${DEPLOYMENT_VERSION:-}"
readonly run_id="${RELEASE_RUN_ID:-local}"
readonly run_attempt="${RELEASE_RUN_ATTEMPT:-1}"

[[ -n "${source_root}" && -d "${source_root}/.next/standalone" ]] || {
  echo 'GITHUB_WORKSPACE does not contain a standalone Next.js build' >&2
  exit 66
}
[[ "${version}" =~ ^[0-9a-f]{40}$ ]] || {
  echo 'DEPLOYMENT_VERSION must be a full Git commit SHA' >&2
  exit 65
}
[[ "${run_id}" =~ ^[0-9]+$ && "${run_attempt}" =~ ^[0-9]+$ ]] || {
  echo 'Release run identifiers must be numeric' >&2
  exit 65
}

readonly release_id="${version:0:12}-${run_id}-${run_attempt}"
readonly release_dir="${deploy_root}/releases/${release_id}"
readonly current_link="${deploy_root}/current"
readonly previous_link="${deploy_root}/previous"
readonly service_source="${source_root}/ops/systemd/portfolio-v2.service"
readonly service_target="${HOME}/.config/systemd/user/portfolio-v2.service"

[[ ! -e "${release_dir}" ]] || {
  echo "Release already exists: ${release_dir}" >&2
  exit 73
}
[[ -f "${source_root}/.next/standalone/server.js" ]] || {
  echo 'Standalone server.js is missing' >&2
  exit 66
}
[[ -d "${source_root}/.next/standalone/public" ]] || {
  echo 'Standalone public assets are missing' >&2
  exit 66
}
[[ -d "${source_root}/.next/standalone/.next/static" ]] || {
  echo 'Standalone static assets are missing' >&2
  exit 66
}

install -d "${deploy_root}/releases" "${HOME}/.config/systemd/user"
install -m 0644 "${service_source}" "${service_target}"
install -d "${release_dir}"
rsync -a --delete "${source_root}/.next/standalone/" "${release_dir}/"

old_release=''
if [[ -L "${current_link}" ]]; then
  old_release="$(readlink -f "${current_link}")"
fi

ln -sfn "${release_dir}" "${deploy_root}/current.new"
mv -Tf "${deploy_root}/current.new" "${current_link}"
if [[ -n "${old_release}" && -d "${old_release}" ]]; then
  ln -sfn "${old_release}" "${deploy_root}/previous.new"
  mv -Tf "${deploy_root}/previous.new" "${previous_link}"
fi

rollback_on_failure() {
  local exit_code="${1:-1}"
  trap - ERR INT TERM HUP
  set +e
  if [[ -n "${old_release}" && -d "${old_release}" ]]; then
    ln -sfn "${old_release}" "${deploy_root}/current.failed"
    mv -Tf "${deploy_root}/current.failed" "${current_link}"
    systemctl --user restart portfolio-v2.service
  else
    systemctl --user stop portfolio-v2.service
    rm -f "${current_link}"
  fi
  exit "${exit_code}"
}
trap 'rollback_on_failure $?' ERR
trap 'rollback_on_failure 130' INT TERM HUP

systemctl --user daemon-reload
systemctl --user enable portfolio-v2.service
systemctl --user restart portfolio-v2.service

for attempt in {1..15}; do
  if curl --fail --silent --show-error http://127.0.0.1:3010/api/health \
    | grep -Fqx '{"ok":true}'; then
    trap - ERR INT TERM HUP
    echo "Activated ${release_id}"
    exit 0
  fi
  sleep 1
done

echo 'V2 did not become healthy after activation' >&2
rollback_on_failure 1
